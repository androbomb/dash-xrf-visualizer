# XRF visualizer — Apptainer recipe. NOT TESTED (see README.md).
# Boots from the Docker image, so build that first:
#   docker build -t xrf-viz -f deploy/docker/Dockerfile .

Bootstrap: docker
From: xrf-viz:latest

%labels
    Description "XRF-only Dash/JAX visualizer (map + spectrum)"
    Maintainer "androbomb"

%runscript
# XRF_CUBE optional (M6): unset -> app starts empty (upload/link in the UI).
uv run python -c "import os; from xrf_visualizer.data import load_cube; from xrf_visualizer.ui import build_app; p = os.environ.get('XRF_CUBE') or None; build_app(load_cube(p).array if p else None).run(host='0.0.0.0', port=8765)"